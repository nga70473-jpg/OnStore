<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet" />

    <!-- ✅ BOOTSTRAP CSS - QUAN TRỌNG -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="~/Content/all.min.css" />
    <link rel="stylesheet" href="~/Content/Layout/HomeLayout.css" />
    <link href="~/Content/View/product.css" rel="stylesheet" />
    <title>LapON</title>
</head>
<body>
    <header>
        <div class="nav-bar">
            <!--Nav-left-->
            <div class="left">
                <a href="@Url.Action("Index", "Home")">
                    <img src="~/Images/Logo/Logo.png" alt="Logo.png" style="height: 70px" />
                </a>
            </div>
            <div class="center">
                <!-- Trang chủ -->
                <a href="@Url.Action("Index", "Home")">Trang chủ</a>
                <!-- Sản phẩm  -->
                <a href="@Url.Action("Index", "Product")">Sản phẩm</a>
                <!-- Sự kiện -->
                <a href="#">Sự kiện</a>
                <!-- Khuyến mãi -->
                <a href="#">Khuyến mãi</a>
                <!-- Liên hệ -->
                <a href="#">Liên hệ</a>
            </div>
            <!--Nav-right-->
            <div class="right">
                <!--search-bar-->
                <div class="search-bar">
                    <input type="text" placeholder="Bạn muốn tìm kiếm gì?" />
                    <i class="fa-solid fa-magnifying-glass" style="font-size: 20px;"></i>
                </div>
                <!--cart-shopping-->
                <a href="#" class="cartShopping" onclick="openCartPopup(); return false;">
                    <i class="fa-solid fa-cart-shopping" style="font-size: 20px; width: 40px; height: 20px;"></i>
                    <span class="cart-badge" id="headerCartCount">0</span>
                </a>
                <span style="color: #fff">|</span>
                <!--SignIn/SingUp-->
                @{
                    if (Session["UserName"] != null)
                    {
                        if (Session["Role"] != null && Session["Role"].ToString() == "Admin")
                        {
                            <a href="@Url.Action("Index", "Admin", new { area = "Admin" })" class="user-name"><i class="fa-solid fa-user"></i>@Session["UserName"]</a>
                        }
                        else
                        {
                            <a href="@Url.Action("Index", "User")" class="user-name"><i class="fa-solid fa-user"></i>@Session["UserName"]</a>
                        }
                        <a href="@Url.Action("Logout", "Account", new {area = ""})">
                            <i class="fa-solid fa-right-from-bracket" style="font-size: 22px"></i>
                        </a>
                    }
                    else
                    {
                        <a href="@Url.Action("Register", "Account")" class="register-link">Đăng ký</a>
                        <a href="@Url.Action("Login", "Account")" class="login-link">Đăng nhập</a>
                    }
                }
            </div>
        </div>
    </header>
    <div class="container" style="padding: 20px 0">
        @RenderBody()
    </div>

    <script src="~/Scripts/all.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/js/bootstrap.min.js"></script>

    @RenderSection("Scripts", required: false)

   
</body>
</html>