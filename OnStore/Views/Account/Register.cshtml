@model OnStore.Models.RegisterView
    @{
        ViewBag.Title = "Register";
        Layout = "~/Views/Shared/_Layout.cshtml";
    }

    <style>
        .form-box {
            width: 600px;
            height: 600px;
            margin: 20px auto;
            padding: 20px 50px;
            border: 1px solid #ccc;
            border-radius: 10px;
            background: #f8f8f8;
            font-family: sans-serif;
        }

            .form-box h2 {
                text-align: center;
                margin-bottom: 10px;
                font-size: 30px;
            }

            .form-box label {
                display: block;
                margin: 5px 0;
                font-weight: bold;
                font-size: 20px;
            }

            .form-box input {
                width: 100%;
                padding: 5px;
                margin: 5px 0;
                border: 1px solid #bbb;
                border-radius: 10px;
                font-size: 20px;
            }

            .form-box button {
                width: 100%;
                margin-top: 15px;
                padding: 15px;
                background-color: black;
                color: white;
                border: none;
                font-size: 18px;
                border-radius: 10px;
                cursor: pointer;
            }

                .form-box button:hover {
                    background-color: red;
                }

            .form-box p {
                text-align: center;
                margin: 20px 0;
            }

            .form-box a {
                text-decoration: none;
                color: red;
            }
    </style>

    <div class="form-box">
        <h2>Đăng ký</h2>
        @using (Html.BeginForm("Register", "Account", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <label>Tên người dùng</label>
            @Html.TextBoxFor(m => m.UserName, new { placeholder = "Nhập tên..." })

            <label>Email</label>
            @Html.TextBoxFor(m => m.Email, new { type = "email", placeholder = "Nhập email..." })

            <label>Mật khẩu</label>
            @Html.PasswordFor(m => m.Password, new { placeholder = "Nhập mật khẩu..." })

            <label>Nhập lại mật khẩu</label>
            @Html.PasswordFor(m => m.ConfirmPassword, new { placeholder = "Nhập lại mật khẩu..." })

            <button type="submit">Đăng ký</button>
        }

        @if (ViewBag.Error != null)
        {
            <p style="color:red">@ViewBag.Error</p>
        }

        <p>Đã có tài khoản? <a href="/Account/Login">Đăng nhập</a></p>
    </div>

